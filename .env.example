# Copie para .env.local e preencha. NÃO comite o .env.local.

# ── Sessão do painel ────────────────────────────────────────────
# Chave aleatória para assinar o cookie de sessão (JWT). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ── Login do painel (/admin) — único editor ─────────────────────
ADMIN_EMAIL=
# Hash bcrypt da senha, em base64 (o script já emite assim — sem "$", seguro p/ .env).
# Gere com:  node scripts/hash-password.mjs "suaSenha"
ADMIN_PASSWORD_HASH=

# ── Vercel Blob (imagens enviadas pelo editor) ─────────────────
# Gerado ao criar o Blob store na Vercel (ou: vercel env pull .env.local)
BLOB_READ_WRITE_TOKEN=

# ── Vercel KV / Upstash Redis (textos editados — fortemente consistente) ──
# Gerado ao conectar o KV/Upstash ao projeto na Vercel. Algumas integrações
# usam os nomes UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
